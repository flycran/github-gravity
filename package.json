{
  "name": "github-gravity",
  "description": "GitHub Actions TypeScript template",
  "version": "0.0.0",
  "author": "",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/actions/typescript-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "bugs": {
    "url": "https://github.com/actions/typescript-action/issues"
  },
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "bun biome check --write . && npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "bun biome format --write .",
    "format:check": "bun biome format .",
    "lint": "bun biome lint .",
    "check": "bun biome check .",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "bun biome check --write . && npm run test && npm run coverage && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@dimforge/rapier2d": "^0.19.3",
    "@dimforge/rapier2d-compat": "^0.19.3",
    "earcut": "^3.2.3",
    "matter-js": "0.14.2",
    "opentype.js": "^2.0.0",
    "planck": "^1.5.0",
    "points-on-path": "^0.2.1",
    "poly-decomp": "^0.3.0",
    "svg-path-parser": "^1.1.0"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@biomejs/biome": "^2.5.4",
    "@github/local-action": "^7.0.1",
    "@jest/globals": "^30.2.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/bun": "^1.3.14",
    "@types/jest": "^30.0.0",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^25.2.3",
    "@types/svg-path-parser": "^1.1.6",
    "jest": "^30.2.0",
    "make-coverage-badge": "^1.2.0",
    "rollup": "^4.57.1",
    "ts-jest": "^29.4.6",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}