{
  "name": "github-gravity",
  "description": "Generate an animated SVG of your GitHub contribution graph falling under gravity, with custom text as collision obstacles",
  "version": "1.0.0",
  "author": "flycran",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/flycran/github-gravity#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flycran/github-gravity.git"
  },
  "bugs": {
    "url": "https://github.com/flycran/github-gravity/issues"
  },
  "keywords": [
    "actions",
    "github-actions",
    "svg",
    "animation",
    "gravity",
    "physics",
    "contributions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "bun biome check --write . && npm run package",
    "ci-test": "bun test",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "bun biome format --write .",
    "format:check": "bun biome format .",
    "lint": "bun biome lint .",
    "check": "bun biome check .",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "test": "bun test",
    "all": "bun biome check --write . && npm run test && npm run coverage && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@dimforge/rapier2d": "^0.19.3",
    "@dimforge/rapier2d-compat": "^0.19.3",
    "earcut": "^3.2.3",
    "opentype.js": "^2.0.0",
    "points-on-path": "^0.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@github/local-action": "^7.0.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.2.3",
    "@types/opentype.js": "^1.3.10",
    "make-coverage-badge": "^1.2.0",
    "rollup": "^4.57.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}